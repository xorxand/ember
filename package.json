{
  "name": "ember-local",
  "productName": "Ember",
  "version": "1.2.0",
  "private": true,
  "description": "A local AI workspace powered by Ollama",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.mjs",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "dev": "vite build --watch",
    "test:ui": "node tests/ui.mjs",
    "package:linux": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src server shared electron scripts tests index.html vite.config.js package.json README.md VALIDATION.md",
    "test:scaling-ui": "node tests/scaling-ui.mjs",
    "test:agent-setup-ui": "node tests/agent-setup-ui.mjs",
    "test:approval-ui": "node tests/approval-policy-ui.mjs",
    "test:timing-ui": "node tests/timing-ui.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.12",
    "marked": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "electron": "42.7.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xorxand/ember.git"
  },
  "homepage": "https://github.com/xorxand/ember#readme",
  "bugs": {
    "url": "https://github.com/xorxand/ember/issues"
  }
}
